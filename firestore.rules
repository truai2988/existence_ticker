rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Basic profile is public, but avoid exposing sensitive fields if possible.
      // In this app, we allow reading the profile to show names/locations.
      // However, we should exclude 'email' from public view if the requester is not the owner.
      allow read: if isSignedIn();
      
      // SCHEMA ENFORCEMENT: Name and Location are required seeds for existence.
      allow create: if isSignedIn() && isOwner(userId)
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.location.prefecture is string
                    && request.resource.data.location.city is string
                    && request.resource.data.balance is number
                    && request.resource.data.last_updated is timestamp;

      allow update: if isSignedIn() && (
        // Case 1: Owner updating own profile
        // email, xp, warmth, used_invitation_code should be protected or managed via transaction/functions
        (isOwner(userId) && request.resource.data.balance >= 0) ||
        // Case 2: Admin Governance
        isAdmin()
      ); 
      
      allow delete: if isAdmin();
      
      match /history/{historyId} {
        allow read: if isOwner(userId);
        // Writing to history should ideally be restricted to system processes or strictly validated
        allow write: if isOwner(userId);
      }
    }

    // --- Wishes Collection ---
    match /wishes/{wishId} {
      allow read: if true;
      // Ensure only the requester can create a wish with their ID
      allow create: if isSignedIn() && request.resource.data.requester_id == request.auth.uid;
      // Allow update only by requester OR the helper (status change)
      allow update: if isSignedIn() && (
        request.resource.data.requester_id == resource.data.requester_id ||
        request.resource.data.helper_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.requester_id == request.auth.uid);
    }

    // --- System Settings (Global Config) ---
    match /system_settings/{docId} {
       allow read: if true;
       allow write: if isAdmin(); 
    }
    
    // --- Transactions & Stats ---
    match /transactions/{txId} {
      // Only involved parties or admin should read transactions
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.sender_id || 
        request.auth.uid == resource.data.recipient_id || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
    }
    
    match /daily_stats/{day} {
      allow read: if true;
      // Stats should be updated via increments, consider tightening if abuse occurs
      allow write: if isSignedIn(); 
    }

    match /location_stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Invitation Codes (Alpha Access Keys) ---
    match /invitation_codes/{codeId} {
      // Allow read for verification during registration
      allow read: if isSignedIn();
      // Allow update ONLY to mark as used during registration transaction
      allow update: if isSignedIn() 
                    && resource.data.is_used == false 
                    && request.resource.data.is_used == true
                    && request.resource.data.used_by == request.auth.uid;
    }
  }
}

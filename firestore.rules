rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSuperAdmin() || isDocAdmin();
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isDocAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Basic profile is public, but email etc. should be protected (implied by schema/code)
      allow read: if isSignedIn();
      
      // SCHEMA ENFORCEMENT: Ensures robust initial state
      allow create: if isSignedIn() && isOwner(userId)
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.location.prefecture is string
                    && request.resource.data.location.city is string
                    && request.resource.data.balance is number
                    && request.resource.data.last_updated is timestamp;

      allow update: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.balance >= 0 && 
         (request.resource.data.role == resource.data.role || !('role' in request.resource.data))
        ) ||
        isAdmin()
      ); 
      
      allow delete: if isAdmin();
      
      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Wishes Collection ---
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.requester_id == request.auth.uid;
      allow update: if isSignedIn() && (
        request.resource.data.requester_id == resource.data.requester_id ||
        request.resource.data.helper_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.requester_id == request.auth.uid);
    }

    // --- System Settings (Global Config) ---
    match /system_settings/{docId} {
       allow read: if true;
       allow write: if isAdmin(); 
    }
    
    // --- Transactions & Stats ---
    match /transactions/{txId} {
      // PERMANENT FIX: Split get/list to allow ritual idempotency while hiding overall logs
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.recipient_id))
      );
      allow create: if isSignedIn() && (request.resource.data.sender_id == request.auth.uid || isAdmin());
    }
    
    match /daily_stats/{day} {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    match /location_stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Invitation Codes (Alpha Access Keys) ---
    match /invitation_codes/{codeId} {
      // PERMANENT FIX: Allow guest read for code verification during registration
      allow read: if true;
      allow update: if isSignedIn() 
                    && resource.data.is_used == false 
                    && request.resource.data.is_used == true
                    && request.resource.data.used_by == request.auth.uid;
    }

    // --- Super Admins ---
    match /super_admins/{uid} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && (isAdmin() || !exists(/databases/$(database)/documents/super_admins/$(uid))); 
    }
  }
}
